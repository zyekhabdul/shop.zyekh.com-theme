{% comment %}
  Bento Grid Categories Section (ZYEKH Engine Standard)
  Features: Modern Bento Grid layout, responsive spans, hover micro-animations, accessible ARIA labels.
{% endcomment %}

<div class="shopify-section section-bento-grid" id="BentoGrid-{{ section.id }}">
  <div class="bento-container">
    {% if section.settings.heading != blank or section.settings.subtitle != blank %}
      <div class="bento-header">
        {% if section.settings.heading != blank %}
          <h2 class="bento-heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="bento-subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="bento-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% assign card_title = block.settings.title | default: collection.title | default: 'Category' %}
        {% assign card_image = block.settings.image | default: collection.featured_image %}
        {% assign card_url = block.settings.url | default: collection.url | default: '#' %}
        {% assign is_large = block.settings.is_large %}

        <div class="bento-card {% if is_large %}bento-card-large{% endif %}" {{ block.shopify_attributes }}>
          <a href="{{ card_url }}" class="bento-card-link" aria-label="{{ card_title | escape }}">
            <div class="bento-image-wrapper">
              {% if card_image != blank %}
                <img
                  src="{{ card_image | image_url: width: 800 }}"
                  alt="{{ card_title | escape }}"
                  width="{{ card_image.width | default: 800 }}"
                  height="{{ card_image.height | default: 600 }}"
                  loading="lazy"
                  class="bento-img"
                >
              {% else %}
                <div class="bento-placeholder">
                  <span>{{ card_title }}</span>
                </div>
              {% endif %}
              <div class="bento-overlay"></div>
            </div>

            <div class="bento-content">
              {% if block.settings.badge_text != blank %}
                <span class="bento-badge">{{ block.settings.badge_text | escape }}</span>
              {% endif %}
              <h3 class="bento-card-title">{{ card_title | escape }}</h3>
              {% if block.settings.description != blank %}
                <p class="bento-card-desc">{{ block.settings.description | escape }}</p>
              {% elsif collection != blank %}
                <span class="bento-count">{{ 'sections.bento_grid.items_count' | t: count: collection.products_count }}</span>
              {% endif %}
              <span class="bento-arrow" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        </div>
      {% else %}
        {% comment %} Default Bento layout fallback {% endcomment %}
        <div class="bento-card bento-card-large">
          <a href="{{ routes.all_products_collection_url }}" class="bento-card-link">
            <div class="bento-image-wrapper">
              <div class="bento-placeholder"><span>Featured Category</span></div>
              <div class="bento-overlay"></div>
            </div>
            <div class="bento-content">
              <span class="bento-badge">HOT</span>
              <h3 class="bento-card-title">Electronics & Tech</h3>
              <span class="bento-count">120+ Products</span>
              <span class="bento-arrow">&rarr;</span>
            </div>
          </a>
        </div>
        <div class="bento-card">
          <a href="{{ routes.all_products_collection_url }}" class="bento-card-link">
            <div class="bento-image-wrapper">
              <div class="bento-placeholder"><span>Category 2</span></div>
              <div class="bento-overlay"></div>
            </div>
            <div class="bento-content">
              <h3 class="bento-card-title">Fashion & Apparel</h3>
              <span class="bento-arrow">&rarr;</span>
            </div>
          </a>
        </div>
        <div class="bento-card">
          <a href="{{ routes.all_products_collection_url }}" class="bento-card-link">
            <div class="bento-image-wrapper">
              <div class="bento-placeholder"><span>Category 3</span></div>
              <div class="bento-overlay"></div>
            </div>
            <div class="bento-content">
              <h3 class="bento-card-title">Home & Living</h3>
              <span class="bento-arrow">&rarr;</span>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-bento-grid {
    padding: var(--space-xl) var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .bento-header {
    margin-bottom: var(--space-lg);
  }
  .bento-heading {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-xs) 0;
    color: var(--color-text, #111827);
  }
  .bento-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-light, #6b7280);
    margin: 0;
  }
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-md);
  }
  @media (min-width: 640px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 240px;
    }
    .bento-card-large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  .bento-card {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    background: var(--color-surface, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    min-height: 200px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }

  .bento-card-link {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    padding: var(--space-lg);
  }

  .bento-image-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }
  .bento-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bento-card:hover .bento-img {
    transform: scale(1.06);
  }

  .bento-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    color: #9ca3af;
    font-weight: 600;
  }

  .bento-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.2) 60%, rgba(0,0,0,0) 100%);
    z-index: 2;
  }

  .bento-content {
    position: relative;
    z-index: 3;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .bento-badge {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: 9999px;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.05em;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .bento-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0 0 4px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }
  .bento-card-large .bento-card-title {
    font-size: 1.85rem;
  }

  .bento-card-desc,
  .bento-count {
    font-size: 0.875rem;
    opacity: 0.9;
    margin: 0;
    text-shadow: 0 1px 2px rgba(0,0,0,0.3);
  }

  .bento-arrow {
    position: absolute;
    right: 0;
    bottom: 0;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }
  .bento-card:hover .bento-arrow {
    transform: translateX(4px);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bento Grid Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Categories"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover top collections curated for you"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Custom Link"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text (e.g. HOT, NEW)"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short Description"
        },
        {
          "type": "checkbox",
          "id": "is_large",
          "label": "Large Hero Span (2x2)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bento Grid Categories",
      "blocks": [
        {
          "type": "category_card",
          "settings": {
            "is_large": true,
            "badge_text": "FEATURED"
          }
        },
        {
          "type": "category_card"
        },
        {
          "type": "category_card"
        }
      ]
    }
  ]
}
{% endschema %}
