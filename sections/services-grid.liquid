{% comment %}
  Transpiled from Bagisto 2.4.x (layouts/services.blade.php) -> Shopify Liquid 2.0 Section
{% endcomment %}

<div class="services-grid bg-gray-50 py-12 border-y border-gray-200">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {% for block in section.blocks %}
        <div class="flex items-center gap-4 rounded-xl bg-white p-5 shadow-sm border border-gray-100" {{ block.shopify_attributes }}>
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-blue-50 text-blue-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ block.settings.svg_path }}"></path>
            </svg>
          </div>
          <div>
            <h4 class="text-sm font-bold text-gray-900">{{ block.settings.title }}</h4>
            <p class="text-xs text-gray-500 mt-0.5">{{ block.settings.description }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

