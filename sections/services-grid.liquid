          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On all orders over Rp 500.000"
        },
        {
          "type": "text",
          "id": "svg_path",
          "label": "SVG Path (d attribute)",
          "default": "M5 13l4 4L19 7"
        }
      ]
    }
  ],
