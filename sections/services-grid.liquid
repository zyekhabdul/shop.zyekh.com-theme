{% schema %}
{
  "name": "Services Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "limit": 4,
      "settings": [
        {
          "type": "textarea",
          "id": "icon_svg",
          "label": "Icon SVG (Raw)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On all orders over $99"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services Grid",
      "blocks": [
        { "type": "service", "settings": { "title": "Free Shipping", "description": "On all orders over $99" } },
        { "type": "service", "settings": { "title": "Return Policy", "description": "30 days money back" } },
        { "type": "service", "settings": { "title": "24/7 Support", "description": "Dedicated support" } },
        { "type": "service", "settings": { "title": "Secure Payment", "description": "100% secure checkout" } }
      ]
    }
  ]
}
{% endschema %}

<div class="services-grid section-spacing">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2 class="services-grid__title text-center">{{ section.settings.title | escape }}</h2>
    {% endif %}
    
    <div class="services-grid__wrapper">
      {% for block in section.blocks %}
        <div class="services-grid__item" {{ block.shopify_attributes }}>
          <div class="services-grid__icon">
            {% if block.settings.icon_svg != blank %}
              {{ block.settings.icon_svg }}
            {% else %}
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
            {% endif %}
          </div>
          <div class="services-grid__text">
            <h3 class="services-grid__item-title">{{ block.settings.title | escape }}</h3>
            <p class="services-grid__item-desc">{{ block.settings.description | escape }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
