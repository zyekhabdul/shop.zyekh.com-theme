<div class="shopify-section hero-banner-wrapper {% if section.settings.image != blank %}has-bg-image{% endif %}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1500 | image_tag: class: 'hero-banner-bg', widths: '750, 1100, 1500', sizes: '100vw', loading: 'eager' }}
  {% endif %}
  <div class="hero-content">
    <h2 class="hero-title">{{ section.settings.heading | escape }}</h2>
    <p class="hero-subtitle">{{ section.settings.subheading | escape }}</p>
    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="btn-primary hero-btn">{{ section.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero-banner-wrapper {
    background: var(--bg-card);
    color: var(--text-main);
    padding: 6rem var(--space-md);
    text-align: center;
    border-radius: var(--radius-lg);
    margin: var(--space-xl) var(--page-margin);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .hero-banner-wrapper.has-bg-image {
    color: var(--bg-card);
    border: none;
  }
  .hero-banner-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.8;
    pointer-events: none;
  }
  .hero-banner-wrapper.has-bg-image::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-overlay); /* Dark overlay for text readability */
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    opacity: 0.8;
    margin: 0;
    max-width: 600px;
  }
  .hero-btn {
    padding: 1rem 2.5rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
    background-color: var(--color-primary);
    color: var(--bg-card);
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: 0 4px 15px color-mix(in srgb, var(--color-primary) 30%, transparent);
  }
  .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }
  .hero-banner-wrapper.has-bg-image .hero-btn {
    background-color: var(--bg-card);
    color: var(--color-primary);
  }
  @media (max-width: 767px) {
    .hero-title { font-size: 2.25rem; }
    .hero-banner-wrapper {
      padding: 4rem var(--space-md);
      margin: var(--space-md) var(--page-margin);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the most viral and winning products of the year."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
