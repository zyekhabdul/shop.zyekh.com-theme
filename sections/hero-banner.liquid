<div class="shopify-section hero-banner-wrapper {% if section.settings.image != blank %}has-bg-image{% endif %}">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 1500 | image_tag: class: 'hero-banner-bg', widths: '750, 1100, 1500', sizes: '100vw', loading: 'eager' }}
  {% endif %}
  <div class="hero-content">
    <div class="hero-badge">
      <span class="pulse-dot"></span> TOP TRENDING 2026
    </div>
    <h1 class="hero-title">{{ section.settings.heading | escape }}</h1>
    <p class="hero-subtitle">{{ section.settings.subheading | escape }}</p>
    {% if section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="btn-primary hero-btn">{{ section.settings.button_label | escape }}</a>
    {% endif %}
    <div class="hero-trust-signals">
      <div class="hero-stars">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      </div>
      <span>Trusted by 10k+ Buyers</span>
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-banner-wrapper {
    background: linear-gradient(135deg, var(--bg-card) 0%, color-mix(in srgb, var(--bg-card) 85%, var(--color-primary)) 100%);
    color: var(--text-main);
    padding: 2.5rem var(--space-md);
    text-align: center;
    border-radius: var(--radius-lg);
    margin: var(--space-md) var(--page-margin);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .hero-banner-wrapper.has-bg-image {
    color: var(--bg-card);
    border: none;
  }
  .hero-banner-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    opacity: 0.8;
    pointer-events: none;
  }
  .hero-banner-wrapper.has-bg-image::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--color-overlay);
    z-index: 0;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-sale);
    color: white;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: white;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
  }
  .hero-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .hero-subtitle {
    font-size: 1rem;
    opacity: 0.8;
    margin: 0;
    max-width: 450px;
  }
  .hero-btn {
    padding: 0.75rem 2rem;
    border-radius: var(--radius-lg);
    text-decoration: none;
    font-weight: 700;
    font-size: 1rem;
    background-color: var(--color-primary);
    color: var(--bg-card);
    transition: transform var(--transition), box-shadow var(--transition);
    box-shadow: 0 4px 15px color-mix(in srgb, var(--color-primary) 30%, transparent);
    margin-top: 4px;
  }
  .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px color-mix(in srgb, var(--color-primary) 40%, transparent);
  }
  .hero-banner-wrapper.has-bg-image .hero-btn {
    background-color: var(--bg-card);
    color: var(--color-primary);
  }
  .hero-trust-signals {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-sm);
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.9;
  }
  .hero-stars {
    display: flex;
    gap: 2px;
    color: var(--color-star);
  }
  @media (max-width: 767px) {
    .hero-title { font-size: 1.75rem; }
    .hero-banner-wrapper {
      padding: 2rem var(--space-md);
      margin: var(--space-sm) var(--page-margin);
    }
    .hero-trust-signals {
      flex-direction: column;
      gap: 4px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover the most viral and winning products of the year."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
