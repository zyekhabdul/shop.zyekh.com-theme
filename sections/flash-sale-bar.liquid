{% comment %}
  Flash Sale Countdown Bar Component (ZYEKH Engine Standard)
  Features: Vanilla ES6+ countdown timer, ARIA accessibility, responsive product row.
{% endcomment %}

<div class="shopify-section section-flash-sale full-width" id="FlashSale-{{ section.id }}" data-end-date="{{ section.settings.end_date | escape }}">
  <div class="flash-sale-wrapper">
    <div class="flash-sale-header">
      <div class="flash-sale-title-group">
        <span class="flash-sale-badge">{{ section.settings.badge_text | default: 'FLASH SALE' | escape }}</span>
        <h2 class="flash-sale-heading">
          {%- if section.settings.heading != blank -%}
            {{ section.settings.heading | escape }}
          {%- else -%}
            {{ 'sections.flash_sale.title' | t }}
          {%- endif -%}
        </h2>
      </div>

      <div class="flash-sale-timer-container" aria-live="polite" aria-label="Flash sale countdown">
        <span class="timer-label">{{ 'sections.flash_sale.ends_in' | t }}:</span>
        <div class="timer-boxes">
          <div class="timer-box">
            <span class="timer-val" data-timer-hours>00</span>
            <span class="timer-unit">{{ 'sections.flash_sale.hours' | t }}</span>
          </div>
          <span class="timer-colon">:</span>
          <div class="timer-box">
            <span class="timer-val" data-timer-minutes>00</span>
            <span class="timer-unit">{{ 'sections.flash_sale.minutes' | t }}</span>
          </div>
          <span class="timer-colon">:</span>
          <div class="timer-box">
            <span class="timer-val" data-timer-seconds>00</span>
            <span class="timer-unit">{{ 'sections.flash_sale.seconds' | t }}</span>
          </div>
        </div>
      </div>

      {% if section.settings.show_button %}
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="flash-sale-cta-btn">
          {%- if section.settings.button_text != blank -%}
            {{ section.settings.button_text | escape }}
          {%- else -%}
            {{ 'sections.flash_sale.shop_all' | t }}
          {%- endif -%} &rarr;
        </a>
      {% endif %}
    </div>

    <div class="flash-sale-products">
      {% assign collection = collections[section.settings.collection] %}
      {% if collection != blank and collection.products_count > 0 %}
        <div class="flash-sale-grid">
          {% for product in collection.products limit: section.settings.products_to_show %}
            {% render 'product-card', product: product %}
          {% endfor %}
        </div>
      {% else %}
        <div class="flash-sale-grid">
          {% for i in (1..section.settings.products_to_show) %}
            <div class="product-card placeholder-card">
              <div class="product-card__image-wrapper product-card__no-image">
                <span>Flash Item {{ i }}</span>
              </div>
              <div class="product-card__content">
                <div class="product-card__header">
                  <p class="product-card__vendor">Flash Deal</p>
                  <h3 class="product-card__title">
                    <a href="#">Flash Sale Product Sample</a>
                  </h3>
                </div>
                <div class="product-card__footer">
                  <div class="product-card__prices">
                    <span class="product-card__price">$29.99</span>
                    <span class="product-card__compare-price">$49.99</span>
                  </div>
                  <button type="button" class="product-card__atc-btn">
                    {{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}
                  </button>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-flash-sale {
    padding: var(--space-xl) var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .flash-sale-wrapper {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.06) 0%, rgba(220, 38, 38, 0.02) 100%);
    border: 1px solid rgba(239, 68, 68, 0.18);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-lg);
  }
  .flash-sale-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .flash-sale-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .flash-sale-badge {
    background: #ef4444;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    padding: 5px 12px;
    border-radius: 9999px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .flash-sale-heading {
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--color-text, #111827);
  }
  .flash-sale-timer-container {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .timer-label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-light, #6b7280);
  }
  .timer-boxes {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .timer-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-surface, #ffffff);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: var(--radius-sm, 6px);
    min-width: 42px;
    padding: 3px 6px;
    box-shadow: 0 2px 6px rgba(239, 68, 68, 0.08);
  }
  .timer-val {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ef4444;
    font-variant-numeric: tabular-nums;
  }
  .timer-unit {
    font-size: 0.6rem;
    text-transform: uppercase;
    color: var(--color-text-light, #6b7280);
    font-weight: 700;
  }
  .timer-colon {
    font-weight: 800;
    color: #ef4444;
  }
  .flash-sale-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #ef4444;
    color: #ffffff;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 9px 20px;
    border-radius: 9999px;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
  }
  .flash-sale-cta-btn:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(239, 68, 68, 0.35);
  }

  .flash-sale-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  /* Product Card Button inside Flash Sale Bar */
  .section-flash-sale .product-card__atc-btn {
    background: #1e293b !important;
    color: #ffffff !important;
    border: none;
    border-radius: 9999px !important;
    padding: 0.45rem 1rem !important;
    font-size: 0.78rem !important;
    font-weight: 700 !important;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .section-flash-sale .product-card__atc-btn:hover {
    background: #0f172a !important;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .flash-sale-wrapper {
      padding: 1rem;
    }
    .flash-sale-header {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .flash-sale-title-group {
      justify-content: flex-start;
    }
    .flash-sale-timer-container {
      justify-content: space-between;
      width: 100%;
      background: rgba(255,255,255,0.6);
      padding: 0.5rem 0.75rem;
      border-radius: 8px;
    }
    .flash-sale-cta-btn {
      width: 100%;
      text-align: center;
      margin-top: 0.25rem;
    }
  }

  @media (min-width: 640px) {
    .flash-sale-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .flash-sale-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

<script>
  (function() {
    function initFlashSaleTimer() {
      const section = document.getElementById('FlashSale-{{ section.id }}');
      if (!section) return;

      const endDateAttr = section.getAttribute('data-end-date');
      let targetTime;

      if (endDateAttr && !isNaN(Date.parse(endDateAttr))) {
        targetTime = new Date(endDateAttr).getTime();
      } else {
        // Default to 24 hours from now if no valid date provided
        targetTime = new Date().getTime() + (24 * 60 * 60 * 1000);
      }

      const hrsEl = section.querySelector('[data-timer-hours]');
      const minsEl = section.querySelector('[data-timer-minutes]');
      const secsEl = section.querySelector('[data-timer-seconds]');

      function updateTimer() {
        const now = new Date().getTime();
        const distance = targetTime - now;

        if (distance <= 0) {
          if (hrsEl) hrsEl.textContent = '00';
          if (minsEl) minsEl.textContent = '00';
          if (secsEl) secsEl.textContent = '00';
          return;
        }

        const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((distance % (1000 * 60)) / 1000);

        if (hrsEl) hrsEl.textContent = String(hours).padStart(2, '0');
        if (minsEl) minsEl.textContent = String(minutes).padStart(2, '0');
        if (secsEl) secsEl.textContent = String(seconds).padStart(2, '0');
      }

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlashSaleTimer);
    } else {
      initFlashSaleTimer();
    }
  })();
</script>

{% schema %}
{
  "name": "Flash Sale Bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flash Sale Deals"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "LIMITED TIME"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End Date (YYYY-MM-DDTHH:mm:ss)",
      "info": "Example: 2026-12-31T23:59:59. Leave blank for rolling 24h timer."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4,
      "label": "Products to show"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All Deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Flash Sale Bar"
    }
  ]
}
{% endschema %}
