{% comment %}
  Circle Category Carousel (ZYEKH Engine Standard)
  Features: Smart dynamic overflow detection, contextual SVG fallbacks, zero awkward whitespace.
{% endcomment %}

<div class="category-carousel-wrapper" data-overflow="false">
  {% if section.blocks.size > 0 %}
    <button type="button" class="category-carousel__nav category-carousel__nav--prev" aria-label="{{ 'general.slider.previous' | t | default: 'Previous' }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="category-carousel">
      {% for block in section.blocks %}
        {% assign cat_title_lower = block.settings.title | downcase %}
        <a href="{{ block.settings.url | default: '#' }}" class="category-carousel__item" {{ block.shopify_attributes }}>
          <div class="category-carousel__avatar">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 200 | image_tag: class: 'category-carousel__image', loading: 'lazy', alt: block.settings.title }}
            {% else %}
              <div class="category-carousel__icon-fallback">
                {% if cat_title_lower contains 'electronic' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                {% elsif cat_title_lower contains 'fashion' or cat_title_lower contains 'cloth' or cat_title_lower contains 'apparel' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 0-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                {% elsif cat_title_lower contains 'home' or cat_title_lower contains 'living' or cat_title_lower contains 'house' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 0 2 2H5a2 2 0 0 0-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                {% elsif cat_title_lower contains 'beauty' or cat_title_lower contains 'cosmetic' or cat_title_lower contains 'care' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l2.4 6.8 6.8 2.4-6.8 2.4L12 20.4l-2.4-6.8-6.8-2.4 6.8-2.4z"/></svg>
                {% elsif cat_title_lower contains 'accessory' or cat_title_lower contains 'jewel' or cat_title_lower contains 'watch' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="6"/><polyline points="12 10 12 12 13.5 13.5"/><path d="M9 2h6l.5 4h-7z"/><path d="M9 22h6l.5-4h-7z"/></svg>
                {% elsif cat_title_lower contains 'gadget' or cat_title_lower contains 'phone' or cat_title_lower contains 'mobile' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                {% else %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                {% endif %}
              </div>
            {% endif %}
          </div>
          <span class="category-carousel__title">{{ block.settings.title | escape }}</span>
        </a>
      {% endfor %}
    </div>

    <button type="button" class="category-carousel__nav category-carousel__nav--next" aria-label="{{ 'general.slider.next' | t | default: 'Next' }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  {% endif %}
</div>

{% stylesheet %}
  .category-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.5rem var(--page-margin);
    width: 100%;
    box-sizing: border-box;
  }
  .category-carousel {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 1.75rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.5rem 0;
    width: 100%;
  }
  .category-carousel::-webkit-scrollbar {
    display: none;
  }

  .category-carousel-wrapper[data-overflow="false"] .category-carousel__nav {
    display: none !important;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel {
    justify-content: flex-start;
    padding: 0.5rem 2.5rem;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav--prev {
    left: var(--page-margin, 1rem);
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav--next {
    right: var(--page-margin, 1rem);
  }

  .category-carousel__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    width: 90px;
    transition: transform var(--transition);
  }
  .category-carousel__item:hover {
    transform: translateY(-4px);
  }
  .category-carousel__avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg-surface, #ffffff);
    border: 2px solid var(--border-color, #e5e7eb);
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(0,0,0,0.05));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .category-carousel__item:hover .category-carousel__avatar {
    border-color: var(--color-primary, #111827);
    box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.1));
  }
  .category-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .category-carousel__icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted, #6b7280);
    background: var(--bg-surface, #f9fafb);
    transition: color var(--transition);
  }
  .category-carousel__item:hover .category-carousel__icon-fallback {
    color: var(--color-primary, #111827);
  }
  .category-carousel__title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main, #111827);
    margin-top: 0.5rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .category-carousel__nav {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e5e7eb);
    color: var(--text-main, #111827);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.08));
    transition: background var(--transition), transform var(--transition);
  }
  .category-carousel__nav:hover {
    background: var(--color-primary, #111827);
    color: #ffffff;
    border-color: var(--color-primary, #111827);
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.querySelector('.category-carousel-wrapper');
    if (!wrapper) return;

    const carousel = wrapper.querySelector('.category-carousel');
    const prevBtn = wrapper.querySelector('.category-carousel__nav--prev');
    const nextBtn = wrapper.querySelector('.category-carousel__nav--next');

    const updateOverflowState = () => {
      if (!carousel) return;
      const isOverflowing = carousel.scrollWidth > carousel.clientWidth;
      wrapper.setAttribute('data-overflow', isOverflowing ? 'true' : 'false');
    };

    updateOverflowState();
    window.addEventListener('resize', updateOverflowState);

    const scrollAmount = 220;

    if (prevBtn && carousel) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    if (nextBtn && carousel) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Category Carousel",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Carousel",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
