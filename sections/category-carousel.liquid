{% comment %}
  Circle Category Carousel (ZYEKH Engine Standard)
  Features: Smart dynamic overflow detection, contextual SVG fallbacks, zero awkward whitespace.
{% endcomment %}

<div class="category-carousel-wrapper" data-overflow="false">
  {% if section.blocks.size > 0 %}
    <button type="button" class="category-carousel__nav category-carousel__nav--prev" aria-label="{{ 'general.slider.previous' | t | default: 'Previous' }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <div class="category-carousel">
      {% for block in section.blocks %}
        {% assign cat_title_lower = block.settings.title | downcase %}
        <a href="{{ block.settings.url | default: '#' }}" class="category-carousel__item" {{ block.shopify_attributes }}>
          <div class="category-carousel__avatar">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 200, height: 200 | image_tag: class: 'category-carousel__image', loading: 'lazy', alt: block.settings.title }}
            {% else %}
              {% assign cat_title_lower = block.settings.title | downcase %}
              {% assign cat_type = 'gadgets' %}
              {% if cat_title_lower contains 'electronic' %}
                {% assign cat_type = 'electronics' %}
              {% elsif cat_title_lower contains 'fashion' or cat_title_lower contains 'cloth' or cat_title_lower contains 'apparel' %}
                {% assign cat_type = 'fashion' %}
              {% elsif cat_title_lower contains 'home' or cat_title_lower contains 'living' or cat_title_lower contains 'house' %}
                {% assign cat_type = 'home' %}
              {% elsif cat_title_lower contains 'beauty' or cat_title_lower contains 'cosmetic' or cat_title_lower contains 'care' %}
                {% assign cat_type = 'beauty' %}
              {% elsif cat_title_lower contains 'accessory' or cat_title_lower contains 'jewel' or cat_title_lower contains 'watch' %}
                {% assign cat_type = 'accessories' %}
              {% elsif cat_title_lower contains 'gadget' or cat_title_lower contains 'phone' or cat_title_lower contains 'mobile' %}
                {% assign cat_type = 'gadgets' %}
              {% endif %}

              {% assign cat_img_filename = 'cat-' | append: cat_type | append: '.jpg' %}
              <img src="{{ cat_img_filename | asset_url }}" width="160" height="160" class="category-carousel__image" loading="lazy" alt="{{ block.settings.title | escape }}">
            {% endif %}
          </div>
          <span class="category-carousel__title">{{ block.settings.title | escape }}</span>
        </a>
      {% endfor %}
    </div>

    <button type="button" class="category-carousel__nav category-carousel__nav--next" aria-label="{{ 'general.slider.next' | t | default: 'Next' }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  {% endif %}
</div>

{% stylesheet %}
  .category-carousel-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 2rem var(--page-margin);
    width: 100%;
    box-sizing: border-box;
  }
  .category-carousel {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 2rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.75rem 0.5rem;
    width: 100%;
  }
  .category-carousel::-webkit-scrollbar {
    display: none;
  }

  .category-carousel-wrapper[data-overflow="false"] .category-carousel__nav {
    display: none !important;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel {
    justify-content: flex-start;
    padding: 0.75rem 2.5rem;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav--prev {
    left: var(--page-margin, 1rem);
  }

  .category-carousel-wrapper[data-overflow="true"] .category-carousel__nav--next {
    right: var(--page-margin, 1rem);
  }

  .category-carousel__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    width: 96px;
    scroll-snap-align: center;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .category-carousel__item:hover {
    transform: translateY(-5px);
  }
  .category-carousel__avatar {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--bg-card, #ffffff);
    border: 3px solid #ffffff;
    outline: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 14px -2px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, outline-color 0.3s ease;
  }
  .category-carousel__item:hover .category-carousel__avatar {
    outline-color: rgba(0, 0, 0, 0.2);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.14);
  }
  .category-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .category-carousel__item:hover .category-carousel__image {
    transform: scale(1.08);
  }

  /* Pastel Duotone Badges */
  .category-carousel__icon-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .category-carousel__icon-fallback svg {
    width: 32px !important;
    height: 32px !important;
    max-width: 32px !important;
    max-height: 32px !important;
    flex-shrink: 0;
    transition: transform 0.3s ease, color 0.3s ease;
  }
  .category-carousel__item:hover .category-carousel__icon-fallback svg {
    transform: scale(1.12);
  }

  .category-carousel__icon-fallback[data-cat-type="electronics"] {
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    color: #2563eb;
  }
  .category-carousel__icon-fallback[data-cat-type="fashion"] {
    background: linear-gradient(135deg, #fff1f2 0%, #ffe4e6 100%);
    color: #e11d48;
  }
  .category-carousel__icon-fallback[data-cat-type="home"] {
    background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
    color: #d97706;
  }
  .category-carousel__icon-fallback[data-cat-type="beauty"] {
    background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
    color: #059669;
  }
  .category-carousel__icon-fallback[data-cat-type="accessories"] {
    background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
    color: #7c3aed;
  }
  .category-carousel__icon-fallback[data-cat-type="gadgets"] {
    background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
    color: #4f46e5;
  }
  .category-carousel__icon-fallback[data-cat-type="general"] {
    background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
    color: #475569;
  }
  .category-carousel__item:hover .category-carousel__icon-fallback {
    color: var(--color-primary, #111827);
  }
  .category-carousel__title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-main, #111827);
    margin-top: 0.5rem;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .category-carousel__nav {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-card, #ffffff);
    border: 1px solid var(--border-color, #e5e7eb);
    color: var(--text-main, #111827);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    box-shadow: var(--shadow-md, 0 4px 6px rgba(0,0,0,0.08));
    transition: background var(--transition), transform var(--transition);
  }
  .category-carousel__nav:hover {
    background: var(--color-primary, #111827);
    color: #ffffff;
    border-color: var(--color-primary, #111827);
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.querySelector('.category-carousel-wrapper');
    if (!wrapper) return;

    const carousel = wrapper.querySelector('.category-carousel');
    const prevBtn = wrapper.querySelector('.category-carousel__nav--prev');
    const nextBtn = wrapper.querySelector('.category-carousel__nav--next');

    const updateOverflowState = () => {
      if (!carousel) return;
      const isOverflowing = carousel.scrollWidth > carousel.clientWidth;
      wrapper.setAttribute('data-overflow', isOverflowing ? 'true' : 'false');
    };

    updateOverflowState();
    window.addEventListener('resize', updateOverflowState);

    const scrollAmount = 220;

    if (prevBtn && carousel) {
      prevBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    if (nextBtn && carousel) {
      nextBtn.addEventListener('click', () => {
        carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Category Carousel",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Carousel",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
