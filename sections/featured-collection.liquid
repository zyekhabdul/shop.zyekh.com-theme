<div class="shopify-section section-featured-collection">
  <div class="collection-header">
    <h2 class="collection-title">{{ section.settings.title | escape }}</h2>
    {% if section.settings.show_view_all %}
      <a href="{{ collections[section.settings.collection].url }}" class="view-all-link">View All &rarr;</a>
    {% endif %}
  </div>

  <div class="product-grid">
    {% assign collection = collections[section.settings.collection] %}
    {% if collection != blank and collection.products_count > 0 %}
      {% for product in collection.products limit: section.settings.products_to_show %}
        <a href="{{ product.url }}" class="product-card">
          <div class="product-image-wrapper">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: class: 'product-image', loading: 'lazy', sizes: '(min-width: 768px) 25vw, 50vw' }}
            {% else %}
              <div class="placeholder-image">No Image</div>
            {% endif %}
          </div>
          <div class="product-info">
            <h3 class="product-title">{{ product.title }}</h3>
            <div class="product-price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for i in (1..section.settings.products_to_show) %}
        <div class="product-card placeholder-card">
          <div class="product-image-wrapper placeholder-image">
            Product {{ i }}
          </div>
          <div class="product-info">
            <h3 class="product-title">Example Product</h3>
            <div class="product-price">$19.99</div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .section-featured-collection {
    padding: var(--space-xl) var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-lg);
  }
  .collection-title {
    font-size: 2rem;
    font-weight: 700;
  }
  .view-all-link {
    text-decoration: none;
    color: var(--color-primary);
    font-weight: 500;
  }
  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }
  @media (min-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-lg);
    }
  }
  .product-card {
    text-decoration: none;
    color: inherit;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition);
    border: 1px solid var(--border-color);
    box-shadow: var(--shadow-sm);
  }
  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  .product-card:hover .product-image {
    transform: scale(1.05);
  }
  .product-image-wrapper {
    aspect-ratio: 1 / 1;
    background-color: var(--bg-main);
    overflow: hidden;
  }
  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }
  .placeholder-image {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    height: 100%;
    background-color: var(--bg-main);
  }
  .product-info {
    padding: var(--space-md);
  }
  .product-title {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
    color: var(--text-main);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .product-price {
    font-weight: 800;
    color: var(--color-primary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8,
      "label": "Maximum products to show"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View all' button"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
