{% comment %}
  Bagisto 2.4.x / Amazon Style Hero Carousel (ZYEKH Engine Standard)
  Zero Tailwind dependency, Vanilla CSS flexbox slider.
{% endcomment %}

<div class="shopify-section hero-carousel-section full-width">
  <div class="hero-carousel-wrapper" id="HeroCarousel-{{ section.id }}">
    <div class="hero-carousel-track" id="heroSlider-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="hero-slide-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1920 | image_tag: class: 'hero-slide-bg', loading: 'lazy', alt: block.settings.heading }}
            <div class="hero-slide-overlay"></div>
          {% else %}
            <img src="{{ 'hero-banner-1.jpg' | asset_url }}" width="1920" height="1080" class="hero-slide-bg" loading="eager" alt="{{ block.settings.heading | escape }}">
            <div class="hero-slide-overlay"></div>
          {% endif %}

          <div class="hero-slide-content">
            <div class="hero-slide-badge">
              <span class="pulse-dot"></span> {{ 'general.meta.trending' | t | default: 'MARKETPLACE DEALS' }}
            </div>
            {% if block.settings.heading != blank %}
              <h2 class="hero-slide-heading">{{ block.settings.heading | escape }}</h2>
            {% endif %}
            {% if block.settings.subheading != blank %}
              <p class="hero-slide-subheading">{{ block.settings.subheading | escape }}</p>
            {% endif %}
            {% if block.settings.button_link != blank and block.settings.button_label != blank %}
              <a href="{{ block.settings.button_link }}" class="btn-primary hero-slide-btn">
                {{ block.settings.button_label | escape }} &rarr;
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <button type="button" class="hero-carousel-nav hero-nav-prev" id="HeroPrev-{{ section.id }}" aria-label="Previous Slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="hero-carousel-nav hero-nav-next" id="HeroNext-{{ section.id }}" aria-label="Next Slide">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero-carousel-section {
    width: 100%;
    position: relative;
    overflow: hidden;
  }
  .hero-carousel-wrapper {
    position: relative;
    width: 100%;
    min-height: 420px;
    background: #090d16;
    color: #ffffff;
  }
  .hero-carousel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    width: 100%;
  }
  .hero-slide-item {
    min-width: 100%;
    box-sizing: border-box;
    position: relative;
    min-height: 440px;
    display: flex;
    align-items: center;
    padding: 3.5rem var(--space-md);
  }
  .hero-slide-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 20%, rgba(59, 130, 246, 0.15) 0%, transparent 55%), linear-gradient(135deg, #090d16 0%, #1e293b 50%, #0f172a 100%);
    z-index: 0;
  }
  .hero-slide-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero-slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(9, 13, 22, 0.85) 0%, rgba(15, 23, 42, 0.5) 100%);
    z-index: 1;
  }
  .hero-slide-content {
    position: relative;
    z-index: 2;
    max-width: var(--page-width);
    margin: 0 auto;
    width: 100%;
    padding: 0 var(--page-margin);
  }
  .hero-slide-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin-bottom: 1.25rem;
    color: #f8fafc;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    display: inline-block;
  }
  .hero-slide-heading {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.12;
    margin-bottom: 1.25rem;
    max-width: 680px;
    color: #ffffff;
  }
  .hero-slide-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.5;
    max-width: 580px;
    margin-bottom: 2rem;
    color: #94a3b8;
    font-weight: 400;
  }
  .hero-slide-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2.25rem;
    border-radius: 999px;
    background: #ffffff;
    color: #0f172a;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background 0.25s ease;
  }
  .hero-slide-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -4px rgba(255, 255, 255, 0.25);
    background: #ffffff;
  }
  .hero-carousel-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
    transition: background 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }
  .hero-carousel-nav:hover {
    background: rgba(255, 255, 255, 0.25);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-50%) scale(1.08);
  }
  .hero-nav-prev { left: 1.5rem; }
  .hero-nav-next { right: 1.5rem; }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('heroSlider-{{ section.id }}');
    const prevBtn = document.getElementById('HeroPrev-{{ section.id }}');
    const nextBtn = document.getElementById('HeroNext-{{ section.id }}');
    if (!track) return;

    let currentIndex = 0;
    const slides = track.querySelectorAll('.hero-slide-item');
    const totalSlides = slides.length;
    if (totalSlides <= 1) return;

    function updateSlider() {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateSlider();
      });
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateSlider();
      });
    }
  });
</script>

{% schema %}
{
  "name": "Bagisto Hero Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Elevate Your Lifestyle"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Discover curated premium items with fast worldwide shipping."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Marketplace"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bagisto Hero Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
