{% comment %}
  Transpiled from Bagisto 2.4.x (carousel/index.blade.php) -> Shopify Liquid 2.0 Section
{% endcomment %}

<div class="hero-carousel full-width relative w-full overflow-hidden bg-gray-900 text-white">
  <div class="carousel-container flex transition-transform duration-500 ease-in-out" id="heroSlider-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="w-full flex-shrink-0 relative min-h-[400px] md:min-h-[550px]" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1920 }}"
            srcset="{{ block.settings.image | image_url: width: 768 }} 768w,
                    {{ block.settings.image | image_url: width: 1280 }} 1280w,
                    {{ block.settings.image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ block.settings.heading | escape }}"
            width="{{ block.settings.image.width | default: 1920 }}"
            height="{{ block.settings.image.height | default: 1080 }}"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          >
          <div class="absolute inset-0 bg-black/40"></div>
        {% else %}
          <div class="absolute inset-0 bg-gradient-to-r from-blue-900 to-indigo-900"></div>
        {% endif %}

        <div class="relative container mx-auto px-6 h-full flex flex-col justify-center items-start text-left z-10 py-20">
          {% if block.settings.heading != blank %}
            <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4 max-w-xl">{{ block.settings.heading }}</h2>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <p class="text-lg md:text-xl text-gray-200 mb-6 max-w-lg">{{ block.settings.subheading }}</p>
          {% endif %}
          {% if block.settings.button_link != blank and block.settings.button_label != blank %}
            <a href="{{ block.settings.button_link }}" class="rounded-lg bg-white px-6 py-3 text-sm font-semibold text-gray-900 hover:bg-gray-100 transition-colors shadow-md">
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Bagisto Hero Carousel",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Elevate Your Lifestyle"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Discover curated premium items with fast worldwide shipping."
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bagisto Hero Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
