{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Welcome to our store"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}

<div class="announcement-bar" style="background: var(--color-primary, #000); color: #fff; text-align: center; padding: 10px;">
  {{ section.settings.text | escape }}
</div>
