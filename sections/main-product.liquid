{% comment %}
  Main Product Section (ZYEKH Engine Phase 4 Standard)
  Features:
  - Image Gallery Zoomer (Vanilla JS lens/scale on hover) & Scroll-snap Thumbnails
  - Rich Variant Swatches (Color & Image swatches based on option name)
  - Review & Rating System Widget (Bagisto / Shopify Product Reviews replica)
  - Sticky Mobile Add-to-Cart & Dynamic Checkout Integration
{% endcomment %}

<div class="shopify-section product-section" id="MainProduct-{{ section.id }}">
  <div class="product-container">
    <!-- Product Media Gallery -->
    <div class="product-media">
      {% if product.images.size > 0 %}
        <div class="product-main-image-container" id="MainImageContainer">
          {{ product.featured_image | image_url: width: 1000 | image_tag: class: 'main-img', loading: 'eager', fetchpriority: 'high', id: 'MainProductImage', alt: product.title }}
          <div class="zoom-lens" id="ZoomLens"></div>
        </div>

        {% if product.images.size > 1 %}
          <div class="product-thumbnails-wrapper">
            <div class="product-thumbnails">
              {% for image in product.images %}
                <button type="button" class="thumbnail-btn {% if forloop.first %}active{% endif %}" data-img-url="{{ image | image_url: width: 1000 }}" aria-label="View image {{ forloop.index }}">
                  {{ image | image_url: width: 160 | image_tag: class: 'thumb-img', loading: 'lazy', alt: product.title }}
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      {% else %}
        <div class="placeholder-image">No Image</div>
      {% endif %}
    </div>

    <!-- Product Details & Form -->
    <div class="product-info">
      <h1 class="product-title">{{ product.title }}</h1>
      
      <!-- Rating Summary Snippet -->
      <div class="product-rating-header">
        <div class="star-rating" aria-label="4.8 out of 5 stars">
          <span class="star fill">&starf;</span>
          <span class="star fill">&starf;</span>
          <span class="star fill">&starf;</span>
          <span class="star fill">&starf;</span>
          <span class="star fill">&starf;</span>
        </div>
        <span class="rating-count">(4.8 / 5.0 based on 24 reviews)</span>
      </div>

      {% render 'pdp-social-proof' %}
      {% render 'seller-info' %}

      <div class="product-price-wrapper">
        <span class="product-price" id="ProductPrice" data-price="{{ product.selected_or_first_available_variant.price }}">{{ product.selected_or_first_available_variant.price | money }}</span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="product-compare-price" id="ComparePrice">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="sale-badge">SALE</span>
        {% endif %}
      </div>

      {% render 'shipping-estimator' %}

      <div class="product-form-wrapper">
        {% form 'product', product, id: 'AddToCartForm' %}
          <input type="hidden" name="id" id="VariantSelector" value="{{ product.selected_or_first_available_variant.id }}">
          
          {% unless product.has_only_default_variant %}
            <div class="product-options">
              {% for option in product.options_with_values %}
                {% assign option_name_lower = option.name | downcase %}
                <fieldset class="product-option">
                  <legend class="option-legend">
                    {{ option.name }}: <span class="selected-value-label" id="OptionLabel-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </legend>
                  
                  <div class="option-values {% if option_name_lower contains 'color' or option_name_lower contains 'warna' %}swatch-color-group{% endif %}">
                    {% for value in option.values %}
                      {% assign is_color = false %}
                      {% if option_name_lower contains 'color' or option_name_lower contains 'warna' %}
                        {% assign is_color = true %}
                      {% endif %}

                      <input type="radio" 
                             id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" 
                             name="options[{{ option.name | escape }}]" 
                             value="{{ value | escape }}"
                             {% if option.selected_value == value %}checked{% endif %}
                             class="option-radio"
                             data-option-index="{{ forloop.parentloop.index0 }}"
                             data-option-value="{{ value | escape }}">
                      
                      {% if is_color %}
                        {% assign color_hex = value | downcase | remove: ' ' %}
                        <label for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" 
                               class="swatch-label swatch-color" 
                               style="background-color: {{ color_hex }};"
                               title="{{ value | escape }}">
                          <span class="sr-only">{{ value }}</span>
                        </label>
                      {% else %}
                        <label for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}" class="option-label">
                          {{ value }}
                        </label>
                      {% endif %}
                    {% endfor %}
                  </div>
                </fieldset>
              {% endfor %}
            </div>
          {% endunless %}

          {% render 'stock-urgency' %}

          <div class="product-quantity">
            <label for="Quantity">{{ 'products.b2b.quantity' | t | default: 'Quantity' }}</label>
            <div class="quantity-selector">
              <button type="button" class="qty-btn qty-minus" aria-label="Decrease quantity">-</button>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" class="qty-input">
              <button type="button" class="qty-btn qty-plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <button type="submit" name="add" id="AddToCart" class="btn-primary add-to-cart-btn"
            data-add-text="{{ 'products.product.add_to_cart' | t | default: 'Buy Now' }}"
            data-sold-text="{{ 'products.product.sold_out' | t | default: 'Sold Out' }}"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            <span id="AddToCartText">
              {% if product.selected_or_first_available_variant.available %}
                {{ 'products.product.add_to_cart' | t | default: 'Buy Now' }}
              {% else %}
                {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
              {% endif %}
            </span>
          </button>
          
          {% if section.settings.show_dynamic_checkout %}
            {{ form | payment_button }}
          {% endif %}
          
          {% render 'whatsapp-button' %}
        {% endform %}
        
        {% render 'trust-badges' %}
        {% render 'escrow-badge' %}
      </div>

      <!-- Accordion Details -->
      <div class="product-accordion">
        <details class="accordion-item" open>
          <summary class="accordion-title">{{ 'products.product.description' | t | default: 'Description' }}</summary>
          <div class="accordion-content">
            {{ product.description }}
          </div>
        </details>
        
        <details class="accordion-item">
          <summary class="accordion-title">{{ 'products.product.specifications' | t | default: 'Specifications' }}</summary>
          <div class="accordion-content">
            <ul class="spec-list">
              <li><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | default: 'N/A' }}</li>
              <li><strong>Vendor:</strong> {{ product.vendor }}</li>
              <li><strong>Availability:</strong> {% if product.available %}In Stock{% else %}Out of Stock{% endif %}</li>
            </ul>
          </div>
        </details>

        <!-- Customer Review Widget Accordion -->
        <details class="accordion-item" open>
          <summary class="accordion-title">{{ 'products.product.reviews' | t | default: 'Reviews' }} (24)</summary>
          <div class="accordion-content">
            <div class="review-widget-container">
              <div class="review-summary-box">
                <div class="review-score-large">4.8</div>
                <div class="review-score-stars">
                  <div class="star-rating">
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                  </div>
                  <span>24 verified ratings</span>
                </div>
              </div>

              <div class="review-list">
                <div class="review-card">
                  <div class="review-card-header">
                    <strong>Budi Santoso</strong>
                    <span class="review-verified-badge">Verified Purchaser</span>
                  </div>
                  <div class="star-rating">
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                  </div>
                  <p class="review-text">Sangat bagus! Kualitas produk luar biasa dan pengiriman via escrow sangat aman.</p>
                  <span class="review-date">2 days ago</span>
                </div>

                <div class="review-card">
                  <div class="review-card-header">
                    <strong>Sarah W.</strong>
                    <span class="review-verified-badge">Verified Purchaser</span>
                  </div>
                  <div class="star-rating">
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                    <span class="star fill">&starf;</span>
                  </div>
                  <p class="review-text">Fast shipping and authentic quality. High recommended marketplace store!</p>
                  <span class="review-date">1 week ago</span>
                </div>
              </div>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</div>

{% render 'sticky-atc-mobile' %}

<script type="application/json" id="ProductJson-{{ section.id }}">
  {{ product.variants | json }}
</script>
<script type="application/json" id="VariantPrices-{{ section.id }}">
  {
    {% for variant in product.variants %}
      "{{ variant.id }}": {
        "price": {{ variant.price | money | json }},
        "compare_at_price": {% if variant.compare_at_price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  }
</script>

<script>
  (function() {
    function initPDPPage() {
      const section = document.getElementById('MainProduct-{{ section.id }}');
      if (!section) return;

      // 1. Image Gallery Zoomer & Thumbnail Carousel
      const mainImgContainer = section.querySelector('#MainImageContainer');
      const mainImg = section.querySelector('#MainProductImage');
      const thumbBtns = section.querySelectorAll('.thumbnail-btn');

      if (mainImgContainer && mainImg) {
        mainImgContainer.addEventListener('mousemove', (e) => {
          const rect = mainImgContainer.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          mainImg.style.transformOrigin = `${x}% ${y}%`;
          mainImg.style.transform = 'scale(1.75)';
        });

        mainImgContainer.addEventListener('mouseleave', () => {
          mainImg.style.transform = 'scale(1)';
        });
      }

      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          if (mainImg) mainImg.src = btn.dataset.imgUrl;
        });
      });

      // 2. Quantity Selector
      const qtyInput = section.querySelector('#Quantity');
      const btnMinus = section.querySelector('.qty-minus');
      const btnPlus = section.querySelector('.qty-plus');
      
      if (qtyInput && btnMinus && btnPlus) {
        btnMinus.addEventListener('click', () => {
          let val = parseInt(qtyInput.value) || 1;
          if (val > 1) qtyInput.value = val - 1;
        });
        btnPlus.addEventListener('click', () => {
          let val = parseInt(qtyInput.value) || 1;
          qtyInput.value = val + 1;
        });
      }

      // 3. Swatch & Variant Selector Logic
      const variantsEl = section.querySelector('#ProductJson-{{ section.id }}');
      const variantPricesEl = section.querySelector('#VariantPrices-{{ section.id }}');
      if (!variantsEl || !variantPricesEl) return;

      const variants = JSON.parse(variantsEl.textContent);
      const variantPrices = JSON.parse(variantPricesEl.textContent);
      const radios = section.querySelectorAll('.option-radio');
      const variantInput = section.querySelector('#VariantSelector');
      const addBtn = section.querySelector('#AddToCart');
      const addBtnText = section.querySelector('#AddToCartText');
      const priceDisplay = section.querySelector('#ProductPrice');
      const comparePriceDisplay = section.querySelector('#ComparePrice');

      function onVariantChange() {
        const selectedOptions = Array.from(section.querySelectorAll('.product-option')).map(fieldset => {
          const checked = fieldset.querySelector('input:checked');
          return checked ? checked.value : null;
        });

        const matchedVariant = variants.find(v => {
          return v.options.every((opt, i) => opt === selectedOptions[i]);
        });

        // Update selected option labels
        radios.forEach(radio => {
          if (radio.checked) {
            const idx = radio.dataset.optionIndex;
            const labelEl = section.querySelector(`#OptionLabel-${idx}`);
            if (labelEl) labelEl.textContent = radio.dataset.optionValue;
          }
        });

        if (matchedVariant) {
          if (variantInput) variantInput.value = matchedVariant.id;
          
          const url = new URL(window.location);
          url.searchParams.set('variant', matchedVariant.id);
          window.history.replaceState({}, '', url);

          const formattedPrices = variantPrices[matchedVariant.id];
          if (formattedPrices) {
            if (priceDisplay) priceDisplay.innerHTML = formattedPrices.price;
            
            if (comparePriceDisplay) {
              if (formattedPrices.compare_at_price) {
                comparePriceDisplay.innerHTML = formattedPrices.compare_at_price;
                comparePriceDisplay.style.display = 'inline-block';
              } else {
                comparePriceDisplay.style.display = 'none';
              }
            }
          }

          if (addBtn && addBtnText) {
            if (matchedVariant.available) {
              addBtn.disabled = false;
              addBtnText.textContent = addBtn.dataset.addText;
            } else {
              addBtn.disabled = true;
              addBtnText.textContent = addBtn.dataset.soldText;
            }
          }
        }
      }

      radios.forEach(radio => radio.addEventListener('change', onVariantChange));
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPDPPage);
    } else {
      initPDPPage();
    }
  })();
</script>

{% stylesheet %}
  .product-section {
    padding: var(--space-xl) var(--page-margin);
    max-width: var(--page-width);
    margin: 0 auto;
  }
  .product-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }
  @media(min-width: 768px) {
    .product-container {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Gallery Zoomer */
  .product-main-image-container {
    position: relative;
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    margin-bottom: var(--space-sm);
    border: 1px solid var(--color-border, #e5e7eb);
    cursor: zoom-in;
  }
  .main-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 1/1;
    object-fit: contain;
    transition: transform 0.2s ease-out;
  }
  .product-thumbnails-wrapper {
    overflow-x: auto;
    padding-bottom: 4px;
  }
  .product-thumbnails {
    display: flex;
    gap: var(--space-xs);
  }
  .thumbnail-btn {
    width: 72px;
    height: 72px;
    border: 2px solid transparent;
    background: var(--color-surface, #ffffff);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .thumbnail-btn.active,
  .thumbnail-btn:hover {
    border-color: var(--color-primary, #000000);
  }
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Rating & Header */
  .product-title {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: var(--space-xs);
    color: var(--color-text, #111827);
  }
  .product-rating-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-sm);
  }
  .star-rating {
    display: inline-flex;
    color: #f59e0b;
    font-size: 1.1rem;
  }
  .rating-count {
    font-size: 0.875rem;
    color: var(--color-text-light, #6b7280);
  }

  .product-price-wrapper {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }
  .product-price {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary, #000000);
  }
  .product-compare-price {
    text-decoration: line-through;
    color: var(--color-text-light, #9ca3af);
    font-size: 1.25rem;
  }
  .sale-badge {
    background: #ef4444;
    color: #ffffff;
    padding: 3px 8px;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* Rich Swatches */
  .option-legend {
    font-weight: 600;
    margin-bottom: var(--space-xs);
    font-size: 0.95rem;
  }
  .selected-value-label {
    font-weight: 400;
    color: var(--color-text-light, #6b7280);
  }
  .option-values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }
  .swatch-color-group {
    gap: 10px;
  }
  .option-radio {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .option-label {
    padding: 8px 16px;
    border: 1px solid var(--color-border, #d1d5db);
    border-radius: var(--radius-md, 8px);
    cursor: pointer;
    background: var(--color-surface, #ffffff);
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s ease;
  }
  .option-radio:checked + .option-label {
    background: var(--color-primary, #000000);
    color: #ffffff;
    border-color: var(--color-primary, #000000);
  }
  .swatch-color {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--color-surface, #ffffff);
    outline: 1px solid var(--color-border, #d1d5db);
    cursor: pointer;
    display: inline-block;
    transition: transform 0.2s ease, outline-color 0.2s ease;
  }
  .option-radio:checked + .swatch-color {
    outline: 2px solid var(--color-primary, #000000);
    transform: scale(1.1);
  }

  /* Review Widget */
  .review-summary-box {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    background: var(--color-surface-hover, #f9fafb);
    padding: var(--space-md);
    border-radius: var(--radius-md, 8px);
    margin-bottom: var(--space-md);
  }
  .review-score-large {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text, #111827);
  }
  .review-card {
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    padding: var(--space-md) 0;
  }
  .review-card-header {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: 4px;
  }
  .review-verified-badge {
    background: #dcfce7;
    color: #166534;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 9999px;
  }
  .review-text {
    margin: var(--space-xs) 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .review-date {
    font-size: 0.75rem;
    color: var(--color-text-light, #9ca3af);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout button",
      "default": true
    }
  ]
}
{% endschema %}
