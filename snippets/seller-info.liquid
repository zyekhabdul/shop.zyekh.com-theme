{%- if product.metafields.supplier.name != blank -%}
<div class="seller-info-widget">
  <div class="seller-header">
    <div class="seller-avatar">
      <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
    </div>
    <div class="seller-details">
      <h4 class="seller-name">{{ product.metafields.supplier.name }}</h4>
      {%- if product.metafields.supplier.location != blank -%}
        <span class="seller-location">
          <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          {{ product.metafields.supplier.location }}
        </span>
      {%- endif -%}
    </div>
  </div>
  <div class="seller-stats">
    {%- if product.metafields.supplier.response_rate != blank -%}
      <div class="stat-item">
        <span class="stat-value">{{ product.metafields.supplier.response_rate }}</span>
        <span class="stat-label">{{ 'products.product.seller_response_rate' | t | default: 'Response Rate' }}</span>
      </div>
    {%- endif -%}
    {%- if product.metafields.seller.rating != blank -%}
      <div class="stat-item">
        <span class="stat-value star-rating">
          ★ {{ product.metafields.seller.rating }}
        </span>
        <span class="stat-label">({{ product.metafields.seller.reviews_count | default: '0' }} Reviews)</span>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
