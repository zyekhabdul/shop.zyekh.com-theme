{%- comment -%}
  Snippet: escrow-badge.liquid
  Displays an escrow shield badge indicating funds are held by the platform.
{%- endcomment -%}

<div class="escrow-badge" aria-label="{{ 'products.product.escrow_badge_aria' | t }}">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5z" fill="#4CAF50"/>
    <path d="M10 15.5l-3.5-3.5 1.41-1.41L10 12.67l6.59-6.59L18 7.5l-8 8z" fill="white"/>
  </svg>
  <span class="escrow-text">{{ 'products.product.escrow_protection' | t }}</span>
</div>
