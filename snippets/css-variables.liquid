{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    
    /* Layout */
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    
    /* Spacing (Bagisto 2.4.x) */
    --space-xs: 0.25rem;
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-2xl: 3rem;

    /* Radius (Bagisto 2.4.x) */
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --style-border-radius-inputs: var(--radius-sm);
    --style-border-radius-card: var(--radius-md);

    /* Animation (Apple fluid spring) */
    --transition: 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    
    /* Shadows (Premium Bento UI) */
    --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.05), 0 1px 3px rgba(0,0,0,0.03);
    --shadow-lg: 0 10px 25px rgba(0,0,0,0.08), 0 4px 10px rgba(0,0,0,0.04);
    
    /* Typography Tracking */
    --tracking-tight: -0.02em;

    /* Colors - Light Mode Default (Bagisto 2.4.x) */
    --bg-main: #F5F5F5;
    --bg-card: #FFFFFF;
    --bg-surface: #F9FAFB;
    --text-main: #111827;
    --text-muted: #6B7280;
    --border-color: #E5E7EB;
    --border-hover: #D1D5DB;
    --color-primary: #0041FF;
    --color-primary-hover: #0036D6;
    --color-sale: #DC2626;
    --color-star: #FBBF24;
    --color-btn-bg: var(--color-primary);
    --color-btn-text: #FFFFFF;
    --color-overlay: rgba(0,0,0,0.5);
    
    --color-background: var(--bg-main);
    --color-foreground: var(--text-main);
  }

  [data-theme="dark"] {
    --bg-main: #09090b;
    --bg-card: #141417;
    --bg-surface: #1f1f22;
    --text-main: #fafafa;
    --text-muted: #a1a1aa;
    --border-color: #27272a;
    --border-hover: #3f3f46;
    --color-primary: #3b82f6;
    --color-primary-hover: #60a5fa;
    --color-sale: #ef4444;
    --color-btn-bg: var(--color-primary);
    --color-btn-text: #ffffff;
    
    --color-background: var(--bg-main);
    --color-foreground: var(--text-main);
  }
{% endstyle %}
