{% comment %}
  Speculation Rules API Level 2 for < 50ms transition delay
  Prefetch links eagerly, Prerender moderately
{% endcomment %}

<script type="speculationrules">
  {
    "prerender": [
      {
        "source": "document",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/cart*" } },
            { "not": { "href_matches": "/account*" } },
            { "not": { "href_matches": "/search*" } }
          ]
        },
        "eagerness": "moderate"
      }
    ],
    "prefetch": [
      {
        "source": "document",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/cart*" } },
            { "not": { "href_matches": "/account*" } },
            { "not": { "href_matches": "/search*" } }
          ]
        },
        "eagerness": "eager"
      }
    ]
  }
</script>

<style>
  /* Enable Cross-Document View Transitions for < 50ms perceived delay */
  @view-transition {
    navigation: auto;
  }
</style>
